# @edl-studio packages live on GitHub Packages (private). Install with:
#   EDL_NPM_TOKEN=$(gh auth token --user al-edl) npm install
@edl-studio:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${EDL_NPM_TOKEN?}
# React, lucide-react and the other UI packages come from Lume's own
# node_modules one folder up, so the stories render the app's single copy.
legacy-peer-deps=true
